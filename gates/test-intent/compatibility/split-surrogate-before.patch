+/* SPDX-License-Identifier: Apache-2.0 */
+package org.apache.tika.parser.csv;
+
+import java.io.IOException;
+import java.io.Reader;
+import org.apache.tika.detect.EncodingDetector;
+import org.apache.tika.sax.XHTMLContentHandler;
+import org.xml.sax.SAXException;
+
+/** Test-intent compatibility scaffolding: Tika 3.2.3's text parser, unchanged. */
+public class SurrogateSafeTextAndCSVParser extends TextAndCSVParser {
+  public SurrogateSafeTextAndCSVParser() {
+    super();
+  }
+
+  public SurrogateSafeTextAndCSVParser(EncodingDetector encodingDetector) {
+    super(encodingDetector);
+  }
+
+  /** Tika 3.2.3 TextAndCSVParser's private text loop: each 4096-char read is sent alone. */
+  static void handleText(Reader reader, XHTMLContentHandler xhtml)
+      throws SAXException, IOException {
+    xhtml.startElement("p");
+    char[] buffer = new char[4096];
+    int n = reader.read(buffer);
+    while (n != -1) {
+      xhtml.characters(buffer, 0, n);
+      n = reader.read(buffer);
+    }
+    xhtml.endElement("p");
+  }
+}
