+package io.justsearch.indexerworker.loop;
+
+import java.util.concurrent.locks.ReentrantLock;
+import java.util.function.Supplier;
+
+/**
+ * Before-state compatibility only (test-intent fail-before run): the type the new checks name for
+ * the loop's fence, as the plain lock the loop and its writer already use. It records nothing.
+ */
+public final class FileMutationFence extends ReentrantLock {
+  public FileMutationFence() {
+    super(true);
+  }
+
+  public <T> T guard(Supplier<T> mutation) {
+    lock();
+    try {
+      return mutation.get();
+    } finally {
+      unlock();
+    }
+  }
+}
