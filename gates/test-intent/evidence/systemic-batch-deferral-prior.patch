--- /dev/null
+++ b/modules/worker-services/src/main/java/io/justsearch/indexerworker/loop/BatchServiceFailures.java
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package io.justsearch.indexerworker.loop;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Consumer;
+
+/**
+ * Judges failures only after the batch has visited the service for every document.
+ * A successful peer proves an isolated failure; argument errors and nonfatal errors are
+ * document failures even without a successful peer. Otherwise a runtime failure of the
+ * shared service defers through the queue's existing fixed one-second retry window.
+ * Single-threaded, like the indexing loop. No failure history survives a batch or success.
+ */
+final class BatchServiceFailures {
+  private final List<Consumer<Boolean>> pending = new ArrayList<>();
+  private boolean active;
+  private boolean succeeded;
+  private boolean deferred;
+  private boolean unavailable;
+
+  void begin() {
+    pending.clear();
+    succeeded = false;
+    deferred = false;
+    unavailable = false;
+    active = true;
+  }
+
+  void success() {
+    succeeded = true;
+  }
+
+  void failure(Throwable failure, Consumer<Boolean> record) {
+    if (active && failure instanceof RuntimeException
+        && !(failure instanceof IllegalArgumentException)) {
+      pending.add(record);
+    } else {
+      record.accept(false);
+    }
+  }
+
+  void unavailable() {
+    unavailable = true;
+  }
+
+  boolean deferredBatch() {
+    return deferred || unavailable;
+  }
+
+  void finish() {
+    active = false;
+    deferred = !succeeded && !pending.isEmpty();
+    try {
+      for (var record : pending) record.accept(deferred);
+    } finally {
+      pending.clear();
+    }
+  }
+}
