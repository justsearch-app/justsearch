+  @CsvSource({"1,2,false,false", "1,2,true,false", "1,1,false,true", "1,1,true,true",
+      "-1,2,false,true", "-1,2,true,true", "0,0,false,true"})
+  void nativeFailureBudgetAndForceSwitchingKeepTheirMeaning(int limit, int failures,
