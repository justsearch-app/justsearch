+package io.justsearch.app.api.runtime.containment;
+
+import java.util.Optional;
+
+/**
+ * Compat (fail-before only): the later Engine containment type. This before-state installs no job,
+ * so the only containment there is is none: UNAVAILABLE, not_installed. No production code here
+ * reads it.
+ */
+public interface EngineContainment {
+  /** The containment this process has. */
+  enum Status { CONTAINED, UNAVAILABLE, NOT_APPLICABLE }
+
+  Status status();
+
+  Optional<String> unavailableReason();
+
+  static EngineContainment current() {
+    return new EngineContainment() {
+      @Override public Status status() { return Status.UNAVAILABLE; }
+      @Override public Optional<String> unavailableReason() { return Optional.of("not_installed"); }
+    };
+  }
+}
