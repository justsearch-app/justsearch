+// Test-intent compatibility scaffolding for the before-state only: the candidate's pure exit step,
+// which the transplanted tests call. Nothing in this before-state's production code calls it.
+#[cfg(windows)]
+fn birth_verdict(seen: Option<&str>, birth: Option<&str>) -> &'static str {
+    match (seen, birth) {
+        (Some(a), Some(b)) if a == b => "ALIVE_MATCH",
+        (Some(_), Some(_)) => "GONE",
+        _ => "IDENTITY_UNKNOWN",
+    }
+}
+#[cfg(windows)]
+fn exit_verdict(
+    wait: windows_sys::Win32::Foundation::WAIT_EVENT,
+    seen: impl FnOnce() -> Option<String>,
+    birth: Option<&str>,
+) -> &'static str {
+    use windows_sys::Win32::Foundation::{WAIT_OBJECT_0, WAIT_TIMEOUT};
+    match wait {
+        WAIT_OBJECT_0 => "GONE",
+        WAIT_TIMEOUT => birth_verdict(seen().as_deref(), birth),
+        _ => "IDENTITY_UNKNOWN",
+    }
+}
