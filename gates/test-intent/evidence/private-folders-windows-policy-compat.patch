+/* SPDX-License-Identifier: Apache-2.0 */
+package io.justsearch.configuration.persistence;
+
+import java.nio.file.Path;
+
+/**
+ * Before-state compatibility for the portable policy checks, not a production replacement.
+ * bc2a09ede OwnerOnlyDirectory.acl/entry builds owner+SYSTEM full-control inheritable ACEs.
+ * Its NIO acl:acl creation attribute and AclFileAttributeView.setAcl do not protect the DACL.
+ * Expose that existing policy using the candidate's descriptor/flag vocabulary. No runtime
+ * caller uses this class in the before-state. Native execution is intentionally unavailable;
+ * only the two descriptor/flag checks are selected for this comparison.
+ */
+final class WindowsOwnerOnlyDirectory {
+  static final String SDDL = "D:(A;OICI;FA;;;OW)(A;OICI;FA;;;SY)";
+  static final int REPAIR_SECURITY_INFORMATION = 0x00000004;
+
+  static void apply(Path path, boolean create) {
+    throw new UnsupportedOperationException("compatibility names only; legacy NIO remains in use");
+  }
+}
