@@ -0,0 +1,25 @@
+//! Before-state compatibility adapter: original EngineHost and original run_supervision only.
+use crate::{engine_host::EngineHost,supervisor::{self,Actuator,Ready,StateRecord}};
+use std::{sync::Arc,path::PathBuf,time::{Instant,Duration}};
+pub(crate) struct ShellActuator {host:Arc<EngineHost>,spawn:Box<dyn FnMut()->Result<u32,String>+Send>,event:Box<dyn FnMut(&StateRecord)+Send>,origin:Instant}
+impl ShellActuator {
+    pub fn new(host:Arc<EngineHost>,_data_dir:PathBuf,mut spawn:impl FnMut()->Result<u32,String>+Send+'static,event:impl FnMut(&StateRecord)+Send+'static)->Self {
+        // Before-state shell setup spawned incarnation one outside the unchanged loop.
+        spawn().unwrap();Self {host,spawn:Box::new(spawn),event:Box::new(event),origin:Instant::now()}
+    }
+}
+impl Actuator for ShellActuator {
+    fn spawn_engine(&mut self)->Result<u32,String> {(self.spawn)()}
+    fn await_ready(&mut self,deadline:u64)->Result<Ready,String> {self.host.await_ready(deadline,||self.origin.elapsed().as_millis() as u64,|_|false)}
+    fn poll_exit(&mut self)->Option<i32> {self.host.try_reap()}
+    fn probe_health(&mut self)->bool {false}
+    fn probe_essential_ready(&mut self)->Option<crate::engine_probe::ReadyEpoch> {None}
+    fn observed_shutdown_reason(&mut self,_current:&Ready)->Option<String> {None}
+    fn write_shutdown_request(&mut self,_reason:&str,_deadline:u64)->Result<(),String> {Ok(())}
+    fn force_kill(&mut self) {let _=self.host.force_stop();}
+    fn wait_for_handle_release(&mut self)->bool {true}
+    fn sleep(&mut self,ms:u64) {std::thread::sleep(Duration::from_millis(ms));}
+    fn monotonic_ms(&mut self)->u64 {self.origin.elapsed().as_millis() as u64}
+    fn publish_state(&mut self,record:&StateRecord) {self.host.publish_state(None,record,|r|(self.event)(r));}
+    fn should_continue(&mut self)->bool {self.host.should_continue()}
+}
