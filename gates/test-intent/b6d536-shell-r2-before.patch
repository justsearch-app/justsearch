+//! Before-state interface scaffolding only; no actuator implementation.
+use crate::{engine_host::EngineHost,supervisor::{Actuator,Ready,StateRecord}};
+use std::{sync::Arc,path::PathBuf};
+pub(crate) struct ShellActuator;
+impl ShellActuator {
+    pub fn new(_host:Arc<EngineHost>,_data_dir:PathBuf,_spawn:impl FnMut()->Result<u32,String>+Send+'static,_event:impl FnMut(&StateRecord)+Send+'static)->Self {
+        Self
+    }
+}
+impl Actuator for ShellActuator {
+    fn spawn_engine(&mut self)->Result<u32,String> {Ok(0)}
+    fn await_ready(&mut self,_deadline:u64)->Result<Ready,String> {Ok(Ready::default())}
+    fn poll_exit(&mut self)->Option<i32> {None}
+    fn probe_health(&mut self)->bool {false}
+    fn probe_essential_ready(&mut self)->Option<crate::engine_probe::ReadyEpoch> {None}
+    fn observed_shutdown_reason(&mut self,_current:&Ready)->Option<String> {None}
+    fn write_shutdown_request(&mut self,_reason:&str,_deadline:u64)->Result<(),String> {Ok(())}
+    fn force_kill(&mut self) {}
+    fn wait_for_handle_release(&mut self)->bool {false}
+    fn sleep(&mut self,_ms:u64) {}
+    fn monotonic_ms(&mut self)->u64 {0}
+    fn publish_state(&mut self,_record:&StateRecord) {}
+    fn should_continue(&mut self)->bool {false}
+}
