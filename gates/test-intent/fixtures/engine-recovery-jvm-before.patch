+// Evidence compatibility only: expose the original lib.rs inline JVM options (baseline
+// c00a0cb24, lines 725 and 781-787), preserving its missing directory creation and fixed names.
+use std::path::Path;
+use serde_json::{json, Value};
+use crate::{exit_ledger, supervisor};
+fn jvm_options(data_dir: &Path) -> Result<Vec<String>, String> {
+    let crash_dir = data_dir.join("crashes");
+    Ok(vec![format!("-XX:ErrorFile={}/hs_err_pid%p.log", crash_dir.to_string_lossy()),
+        format!("-XX:HeapDumpPath={}/", crash_dir.to_string_lossy())])
+}
