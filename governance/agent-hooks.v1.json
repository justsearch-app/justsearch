{
  "$schema": "./agent-hooks.v1.schema.json",
  "kind": "agent-hooks-manifest.v1",
  "version": 1,
  "comment": "Single authority for agent hook policy and binding. Tracked Claude settings are generated by scripts/codegen/gen-agent-hooks.mjs; maintainer-local wiring uses gen-agent-hooks-wiring.mjs. Codex hooks are generated by scripts/codegen/gen-codex-hooks.mjs and normalized through codex-hook-adapter.mjs. Harness-specific projections must be checked; do not hand-edit generated hook blocks. Tempdoc 930 §18.1 row 4 retired the Bash guard and 21 other hooks -- 19 advisory hints plus the taskcreate-guard and maintain-doc-hint blocking pair (measured: zero true positives for its git/sleep rules over 30 days, no measured effect for the hint tier); force-push protection now lives in .claude/settings.json permissions.deny.",
  "hookDir": "scripts/agent-analytics/hooks",
  "hooks": {
    "codex-hook-adapter": {
      "file": "codex-hook-adapter.mjs",
      "role": "advisory",
      "wiring": "codex-adapter",
      "wiringNote": "Codex hooks.json invokes this harness adapter once per supported lifecycle event; it then dispatches the matching shared manifest bindings in order. It is intentionally not a Claude binding."
    },
    "build-counter": {
      "file": "build-counter.mjs",
      "role": "blocking",
      "bite": {
        "kind": "unit",
        "test": "scripts/agent-analytics/hooks/build-counter.test.mjs",
        "note": "state-dependent (3 fails); unit-tested (520)"
      }
    },
    "compact-restore": {
      "file": "compact-restore.mjs",
      "role": "advisory"
    },
    "compact-save": {
      "file": "compact-save.mjs",
      "role": "advisory"
    },
    "dispatch": {
      "file": "dispatch.mjs",
      "role": "telemetry"
    },
    "docs-regen-hint": {
      "file": "docs-regen-hint.mjs",
      "role": "advisory"
    },
    "agent-spawn-sweep-hint": {
      "file": "agent-spawn-sweep-hint.mjs",
      "role": "advisory"
    },
    "agent-spawn-session-end-reap": {
      "file": "agent-spawn-session-end-reap.mjs",
      "role": "advisory"
    },
    "agent-spawn-build-hint": {
      "file": "agent-spawn-build-hint.mjs",
      "role": "advisory"
    },
    "export-session-env": {
      "file": "export-session-env.mjs",
      "role": "advisory"
    },
    "otlp-sink-ensure": {
      "file": "otlp-sink-ensure.mjs",
      "role": "telemetry",
      "bite": {
        "kind": "unit",
        "test": "scripts/agent-analytics/hooks/otlp-sink-ensure.test.mjs",
        "note": "829 R8: not blocking (role stays telemetry, enforcer skips non-blocking bite), but exercises the death-warning/staleness-notice message builders + launch-log tail reader so the fail-loud path (asyncRewake + exit 2, see the SessionStart binding) has a regression guard, not just the manual negative probe"
      }
    },
    "publication-merge-guard": {
      "file": "publication-merge-guard.mjs",
      "role": "blocking",
      "bite": {
        "kind": "unit",
        "test": "scripts/agent-analytics/hooks/publication-merge-guard.test.mjs",
        "note": "Tempdoc 933: direct agent CLI merge requests must route through the live publication-record preflight; the pure detector and process exit contract are unit-tested."
      }
    },
    "intervene": {
      "file": "intervene.mjs",
      "role": "blocking",
      "bite": {
        "kind": "unit",
        "test": "scripts/agent-analytics/hooks/intervene.test.mjs",
        "note": "state-dependent (>10 reads); decision core proven by its unit test (520)"
      }
    },
    "lockfile-hint": {
      "file": "lockfile-hint.mjs",
      "role": "advisory"
    },
    "mcpb-repack-hint": {
      "file": "mcpb-repack-hint.mjs",
      "role": "advisory"
    },
    "mcp-session-inject": {
      "file": "mcp-session-inject.mjs",
      "role": "advisory"
    },
    "repeat-guard": {
      "file": "repeat-guard.mjs",
      "role": "blocking",
      "bite": {
        "kind": "unit",
        "test": "scripts/agent-analytics/hooks/repeat-guard.test.mjs",
        "note": "state-dependent (3 identical); unit-tested (520)"
      }
    },
    "ssot-hint": {
      "file": "ssot-hint.mjs",
      "role": "advisory"
    },
    "subagent-guide": {
      "file": "subagent-guide.mjs",
      "role": "advisory"
    },
    "subagent-model-guard": {
      "file": "subagent-model-guard.mjs",
      "role": "blocking",
      "bite": {
        "kind": "command-signal",
        "stdin": {
          "hook_event_name": "PreToolUse",
          "tool_name": "Agent",
          "tool_input": {
            "prompt": "probe"
          }
        },
        "expect": {
          "exitCode": 2
        },
        "note": "an Agent spawn with no explicit `model` inherits the parent's (claude-code#74788) -> exit 2; unit test covers the fable + explicit-model arms"
      }
    },
    "worktree-base-hint": {
      "file": "worktree-base-hint.mjs",
      "role": "advisory",
      "bite": {
        "kind": "unit",
        "test": "scripts/agent-analytics/hooks/worktree-base-hint.test.mjs",
        "note": "mechanizes verify-worktree-base; tempdoc 727 F-3 adds the uncommitted-changes-on-main check; tempdoc 940 compares the worktree against origin/main (baseRef fresh) and flags a local main that is ahead of origin (stranded commits) — all proven by its unit test"
      }
    }
  },
  "bindings": {
    "SessionStart": [
      {
        "hooks": [
          {
            "hookId": "export-session-env",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "hookId": "compact-restore",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "hookId": "otlp-sink-ensure",
            "timeout": 5,
            "asyncRewake": true
          }
        ]
      },
      {
        "hooks": [
          {
            "hookId": "agent-spawn-sweep-hint",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "hookId": "intervene",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "hookId": "intervene",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "hookId": "publication-merge-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "hookId": "agent-spawn-build-hint",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "hookId": "build-counter",
            "if": "Bash(./gradlew*)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "hookId": "repeat-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__justsearch-dev__.*",
        "hooks": [
          {
            "hookId": "mcp-session-inject",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "hookId": "subagent-model-guard",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "hookId": "build-counter",
            "if": "Bash(./gradlew*)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "hookId": "docs-regen-hint",
            "if": "Edit(docs/**)"
          },
          {
            "hookId": "ssot-hint",
            "if": "Edit(**/SSOT/catalogs/**)"
          },
          {
            "hookId": "mcpb-repack-hint",
            "if": "Edit(packaging/mcpb/server/**)|Write(packaging/mcpb/server/**)|Edit(packaging/mcpb/manifest.json)|Write(packaging/mcpb/manifest.json)"
          },
          {
            "hookId": "intervene",
            "if": "Edit(docs/tempdocs/**)|Write(docs/tempdocs/**)"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "hookId": "lockfile-hint",
            "if": "Edit(**/build.gradle.kts)"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "hookId": "worktree-base-hint",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "hookId": "compact-save",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "hookId": "subagent-guide",
            "timeout": 5
          }
        ],
        "matcher": "Explore|Plan"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "hookId": "dispatch",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "hookId": "agent-spawn-session-end-reap",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
