{
  "kind": "justsearch-workflow-signal-policy.v1",
  "version": 6,
  "defaultStaleDays": 14,
  "branchProtection": {
    "requireBranchesUpToDateBeforeMerging": false
  },
  "workflows": [
    {
      "name": "CI",
      "path": ".github/workflows/ci.yml",
      "class": "public-hosted-fact-lanes",
      "expectedTriggers": ["workflow_dispatch", "pull_request", "push", "merge_group"],
      "owner": "ADR-0044 / public hosted CI fact lanes",
      "failureDefault": "product-regression",
      "staleDays": 14,
      "blocking": true,
      "advisory": false,
      "requiredStatusChecks": [
        "Public claims",
        "License and notices",
        "Build (no model blobs)",
        "Unit tests (app-ui)",
        "Unit tests (search-worker)",
        "Unit tests (platform-contracts)",
        "Windows-native tests",
        "Shell crate tests (Rust)",
        "Secret scan",
        "jseval Python suite"
      ]
    },
    {
      "name": "CLA Assistant",
      "path": ".github/workflows/cla.yml",
      "class": "contributor-provenance",
      "expectedTriggers": ["issue_comment", "pull_request_target", "merge_group"],
      "owner": "CLA.md / CONTRIBUTING.md",
      "failureDefault": "contributor-policy",
      "staleDays": 14,
      "blocking": true,
      "advisory": false,
      "requiredStatusChecks": ["cla-assistant"]
    },
    {
      "name": "Build Installer",
      "path": ".github/workflows/build-installer.yml",
      "class": "release-gate",
      "expectedTriggers": ["workflow_dispatch"],
      "owner": "tempdoc 374 / Production-Reality Verification",
      "failureDefault": "release-blocking-failure",
      "staleDays": 14,
      "blocking": true,
      "advisory": false
    },
    {
      "name": "Update Preserves Models",
      "path": ".github/workflows/update-preserves-models.yml",
      "class": "release-gate",
      "expectedTriggers": ["workflow_dispatch"],
      "owner": "tempdoc 617 D2 section 9 items 3-5 / tempdoc 930 section 18.1 row 11",
      "failureDefault": "release-blocking-failure",
      "staleDays": 365,
      "blocking": true,
      "advisory": false
    },
    {
      "name": "Sign Vendored Mirrors",
      "path": ".github/workflows/sign-vendored-mirrors.yml",
      "class": "release-gate",
      "expectedTriggers": ["workflow_dispatch"],
      "owner": "tempdoc 760/772 SS-K sign-once-per-upstream-bump",
      "failureDefault": "release-blocking-failure",
      "staleDays": 365,
      "blocking": false,
      "advisory": true
    },
    {
      "name": "Docs lint",
      "path": ".github/workflows/docs-lint.yml",
      "class": "docs-manual-gate",
      "expectedTriggers": ["workflow_dispatch"],
      "owner": "documentation maintenance",
      "failureDefault": "product-regression",
      "staleDays": 7,
      "blocking": true,
      "advisory": false
    },
    {
      "name": "CodeQL",
      "path": ".github/workflows/codeql.yml",
      "class": "security-scan",
      "expectedTriggers": ["workflow_dispatch"],
      "owner": "security automation",
      "failureDefault": "security-signal",
      "staleDays": 30,
      "blocking": false,
      "advisory": true
    },
    {
      "name": "CI wall-clock trend",
      "path": ".github/workflows/ci-walltime-trend.yml",
      "class": "scheduled-quality-signal",
      "expectedTriggers": ["workflow_dispatch"],
      "owner": "tempdoc 668 / public CI wall-clock attribution",
      "failureDefault": "workflow-assumption-drift",
      "staleDays": 30,
      "blocking": false,
      "advisory": true
    },
    {
      "name": "Onramp Smoke",
      "path": ".github/workflows/onramp-smoke.yml",
      "class": "scheduled-quality-signal",
      "expectedTriggers": ["workflow_dispatch"],
      "owner": "tempdoc 656 / onramp Tier-0 first-success proof-lane",
      "failureDefault": "product-regression",
      "staleDays": 7,
      "blocking": false,
      "advisory": true
    },
    {
      "name": "Dependabot Updates",
      "path": "github-managed",
      "class": "dependency-automation",
      "expectedTriggers": ["dependabot"],
      "owner": "dependency maintenance",
      "failureDefault": "workflow-assumption-drift",
      "staleDays": 30,
      "blocking": false,
      "advisory": true
    },
    {
      "name": "Dependency Graph",
      "path": "github-managed",
      "class": "dependency-automation",
      "expectedTriggers": ["dynamic"],
      "owner": "dependency maintenance",
      "failureDefault": "workflow-assumption-drift",
      "staleDays": 30,
      "blocking": false,
      "advisory": true
    }
  ]
}
