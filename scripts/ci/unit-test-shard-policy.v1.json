    {
      "lane": "search-worker",
      "requiredCheck": "Unit tests (search-worker)",
      "artifact": "unit-test-attribution-search-worker",
      "runnerLabel": "ubuntu-latest/search-worker",
      "owner": "search and worker hosted unit evidence",
      "platformClass": "mixed/needs targeted experiment",
      "platformRiskNotes": [
        "Includes Tika/PDF fixture-adjacent behavior, Lucene filesystem behavior, index locking, and worker model discovery.",
        "Contains path and worker-runtime assumptions that need targeted proof before a platform move.",
        "Migrated to ubuntu-latest (tempdoc 668). Cross-platform issues fixed (isCloudPlaceholder attr read, path-separator handling, blank-prefix guard, IndexRootLock spawn); timing-sensitive DrainAndClose method runs @Tag windows on the windows-native-tests lane."
      ],
      "gradleTasks": [
        ":modules:adapters-lucene:test",
        ":modules:configuration:test",
        ":modules:core:test",
        ":modules:core-contracts:test",
        ":modules:indexer-worker:test",
        ":modules:indexing:test",
        ":modules:ipc-common:test",
        ":modules:worker-core:test",
        ":modules:worker-services:test"
      ],
      "localCommand": "node scripts/lib/tool-invoker.cjs gradle :modules:adapters-lucene:test :modules:configuration:test :modules:core:test :modules:core-contracts:test :modules:indexer-worker:test :modules:indexing:test :modules:ipc-common:test :modules:worker-core:test :modules:worker-services:test -PskipWebBuild=true --console=plain",
      "advisoryBudgets": {
        "maxSummedSuiteSeconds": 300,
        "slowSuiteWarnSeconds": 60,
        "maxSkipped": 50
      }
    },
    {
      "lane": "platform-contracts",
      "requiredCheck": "Unit tests (platform-contracts)",
      "artifact": "unit-test-attribution-platform-contracts",
      "runnerLabel": "ubuntu-latest/platform-contracts",
      "owner": "platform, inference, contract, and governance hosted unit evidence",
      "platformClass": "mixed/needs targeted experiment",
      "platformRiskNotes": [
        "Includes GPU bridge, ORT/common, app-inference, system-test substrate, and native/runtime assumptions.",
        "Includes app-engine recovery and mutation tests. The expected 9-12 minute addition fits the 25-minute hard timeout but exceeds every existing shard's advisory walltime and summed-suite budgets; platform-contracts has the lowest recorded hosted maximum. Review budgets after hosted measurement rather than treating this estimate as proof.",
        "Migrated to ubuntu-latest (tempdoc 668). GPU/ORT tests self-skip via @EnabledOnOs; the timing-sensitive LlamaServerOps crash-telemetry method runs @Tag windows on the windows-native-tests lane.",
        "Advisory --continue Linux runs were used to enumerate and fix the portability tail before flipping."
      ],
      "gradleTasks": [
        ":modules:ai-backend:test",
        ":modules:api-contract-projection-java:test",
        ":modules:app-engine:test",
        ":modules:app-inference:test",
        ":modules:benchmarks:test",
        ":modules:dead-code-audit:test",
        ":modules:extension-substrate:test",
        ":modules:gpu-bridge:test",
        ":modules:infra-core:test",
        ":modules:ort-common:test",
        ":modules:prompt-support:test",
        ":modules:reranker:test",
        ":modules:ssot-tools:test",
        ":modules:system-tests:test",
        ":modules:telemetry:test",
        ":modules:test-support:test"
      ],
      "localCommand": "node scripts/lib/tool-invoker.cjs gradle :modules:ai-backend:test :modules:api-contract-projection-java:test :modules:app-engine:test :modules:app-inference:test :modules:benchmarks:test :modules:dead-code-audit:test :modules:extension-substrate:test :modules:gpu-bridge:test :modules:infra-core:test :modules:ort-common:test :modules:prompt-support:test :modules:reranker:test :modules:ssot-tools:test :modules:system-tests:test :modules:telemetry:test :modules:test-support:test -PskipWebBuild=true --console=plain",
      "advisoryBudgets": {
        "maxSummedSuiteSeconds": 300,
        "slowSuiteWarnSeconds": 60,
        "maxSkipped": 50
      }
    }
  ],
  "aggregates": [
    {
      "jobId": "app-ui",
      "requiredCheck": "Unit tests (app-ui)",
      "parts": [
        "app-ui-ui",
        "app-ui-services"
      ]
    },
    {
      "jobId": "windows-native-tests",
      "requiredCheck": "Windows-native tests",
      "parts": [
        "windows-native-node",
        "windows-native-contracts"
      ]
    }
  ],
  "windowsParts": [
    {
      "jobId": "windows-native-node",
      "commands": [
        "npm ci --audit=false",
        "npm ci --prefix modules/ui-web --audit=false",
        "npm run test:dev-runner -- --verbose"
      ],
      "gradleTasks": []
    },
    {
      "jobId": "windows-native-contracts",
      "commands": [
        "node --test scripts/release/evidence-capture-exit.test.mjs",
        "node scripts/supervisor-conformance/run.mjs --adapter dev-runner",
        "node scripts/supervisor-conformance/run.mjs --adapter dev-runner --case fileless-clean-local-restart-is-not-counted --repeat 50",
        "./scripts/ci/test-release-compatibility-baseline.ps1",
        "./scripts/ci/test-install-codesign-tool.ps1",
        "./scripts/ci/test-resolve-release-signing.ps1",
