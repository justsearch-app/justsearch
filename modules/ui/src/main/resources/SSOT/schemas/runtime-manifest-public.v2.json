{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssot.justsearch/v2/schemas/runtime-manifest-public.v2.json",
  "title": "JustSearch public runtime manifest",
  "type": "object",
  "$defs": {
    "worker": {
      "type": "object",
      "properties": {
        "state": { "type": "string", "enum": ["pending", "ready", "failed"] },
        "indexBasePath": { "type": "string" },
        "readyAt": { "type": "string" },
        "spawnError": { "type": "string" }
      },
      "required": ["state"],
      "additionalProperties": true
    },
    "contextWindow": {
      "type": "object",
      "properties": {
        "rung": { "type": "integer" },
        "reason": { "type": "string" },
        "freeVramBytes": { "type": "integer" },
        "slots": { "type": "integer" },
        "kvType": { "type": "string" }
      },
      "required": ["rung", "slots"],
      "additionalProperties": true
    },
    "ai": {
      "type": "object",
      "properties": {
        "phase": { "type": "string" },
        "required": { "type": "boolean" },
        "pendingReason": { "type": "string" },
        "readyAt": { "type": "string" },
        "serverBuildExpected": { "type": "string" },
        "serverBuildActual": { "type": "string" },
        "thinkingSupport": { "type": "string" },
        "contextWindow": { "$ref": "#/$defs/contextWindow" }
      },
      "required": ["required"],
      "additionalProperties": true
    },
    "transport": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "url": { "type": "string" },
        "audience": { "type": "string", "enum": ["public"] }
      },
      "required": ["audience"],
      "additionalProperties": true
    },
    "reachability": {
      "type": "object",
      "properties": {
        "transports": { "type": "array", "items": { "$ref": "#/$defs/transport" } }
      },
      "required": ["transports"],
      "additionalProperties": true
    },
    "mode": {
      "type": "object",
      "properties": {
        "intent": { "type": "string" },
        "realized": { "type": "string" }
      },
      "additionalProperties": true
    },
    "constituents": {
      "type": "object",
      "properties": {
        "manifestSchemaVersion": { "type": "integer" },
        "lifecycleSchemaVersion": { "type": "integer" },
        "mcpProtocolVersion": { "type": "string" },
        "mcpToolSurfaceVersion": { "type": "string" }
      },
      "required": [
        "manifestSchemaVersion",
        "lifecycleSchemaVersion",
        "mcpProtocolVersion",
        "mcpToolSurfaceVersion"
      ],
      "additionalProperties": true
    },
    "runtimeContract": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "constituents": { "$ref": "#/$defs/constituents" }
      },
      "required": ["version"],
      "additionalProperties": true
    },
    "chat": {
      "type": "object",
      "properties": {
        "profileId": { "type": "string" },
        "modelFile": { "type": "string" },
        "mmprojActive": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schemaVersion": { "const": 2 },
    "instanceId": { "type": "string", "minLength": 1 },
    "pid": { "type": "integer" },
    "startedAt": { "type": "string" },
    "dataDir": { "type": "string" },
    "lifecycle": { "type": ["string", "null"] },
    "head": {
      "type": "object",
      "properties": {
        "apiPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "apiBaseUrl": { "type": "string", "pattern": "^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]+)?$" },
        "readyAt": { "type": "string" },
        "buildStamp": { "type": "string" }
      },
      "dependentRequired": {
        "apiPort": ["apiBaseUrl", "readyAt"],
        "apiBaseUrl": ["apiPort", "readyAt"],
        "readyAt": ["apiPort", "apiBaseUrl"]
      },
      "additionalProperties": false
    },
    "worker": { "$ref": "#/$defs/worker" },
    "ai": { "$ref": "#/$defs/ai" },
    "reachability": { "$ref": "#/$defs/reachability" },
    "mode": { "$ref": "#/$defs/mode" },
    "runtimeContract": { "$ref": "#/$defs/runtimeContract" },
    "chat": { "$ref": "#/$defs/chat" }
  },
  "required": ["schemaVersion", "instanceId", "pid", "startedAt", "dataDir", "head"],
  "additionalProperties": true
}
