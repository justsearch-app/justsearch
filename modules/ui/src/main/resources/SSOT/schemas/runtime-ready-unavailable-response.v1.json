{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssot.justsearch/v1/schemas/runtime-ready-unavailable-response.v1.json",
  "$comment": "Generated by node contracts/runtime/generate-readiness-schema.mjs; do not edit.",
  "title": "JustSearch runtime readiness unavailable response",
  "description": "A readiness probe failure or an Engine admission refusal.",
  "oneOf": [
    {
      "$ref": "#/$defs/ReadinessResponse"
    },
    {
      "$ref": "#/$defs/ApiErrorResponse"
    }
  ],
  "$defs": {
    "ReadinessResponse": {
      "title": "JustSearch runtime readiness response",
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "lifecycle": {
          "type": [
            "string",
            "null"
          ]
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ready",
        "lifecycle",
        "instanceId"
      ],
      "additionalProperties": false
    },
    "ApiErrorResponse": {
      "title": "JustSearch API error response",
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "errorCode": {
          "type": "string"
        },
        "errorClass": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "retrySafe": {
          "type": "boolean"
        },
        "i18nKey": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "description": "When present, the earliest useful retry in milliseconds (a TRANSIENT refusal such as CHAT_UNAVAILABLE). Absent when the Engine does not know."
        },
        "reason": {
          "type": "string",
          "enum": [
            "GPU_BUSY",
            "GAME_MODE",
            "RELOAD_BACKOFF",
            "LOADING",
            "BUSY",
            "OFF",
            "FAILED",
            "REFUSED",
            "ENGINE_STOPPING",
            "DEVICE_RECOVERING",
            "SELF_TEST"
          ],
          "description": "A chat refusal's reason (Spec A step 9): why this one request was not admitted. Present only on chat refusals."
        },
        "forceAllowed": {
          "type": "boolean",
          "description": "On a chat refusal: true when the app may offer the person a load in spite of it (POST /api/chat/load-anyway). Never true for an agent."
        }
      },
      "required": [
        "error",
        "errorCode"
      ],
      "additionalProperties": false
    }
  }
}
