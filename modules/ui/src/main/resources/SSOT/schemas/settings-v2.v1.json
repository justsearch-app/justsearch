{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "type" : "object",
  "properties" : {
    "apiPort" : {
      "type" : [ "integer", "null" ]
    },
    "citationScorerModelPath" : {
      "type" : [ "string", "null" ]
    },
    "composition" : {
      "type" : [ "object", "null" ],
      "properties" : {
        "footprintBytes" : {
          "type" : [ "integer", "null" ]
        },
        "freeBytes" : {
          "type" : [ "integer", "null" ]
        },
        "mode" : {
          "type" : [ "string", "null" ]
        },
        "reason" : {
          "type" : [ "string", "null" ]
        }
      }
    },
    "indexPaths" : {
      "type" : [ "array", "null" ],
      "items" : {
        "type" : "string"
      }
    },
    "llm" : {
      "type" : [ "object", "null" ],
      "properties" : {
        "contextWindow" : {
          "type" : [ "integer", "null" ]
        },
        "gameDetection" : {
          "type" : [ "string", "null" ]
        },
        "gpuLayers" : {
          "type" : [ "integer", "null" ]
        },
        "llamaLibPath" : {
          "type" : [ "string", "null" ]
        },
        "maxTokens" : {
          "type" : [ "integer", "null" ]
        },
        "modelPath" : {
          "type" : [ "string", "null" ]
        },
        "serverExecutable" : {
          "type" : [ "string", "null" ]
        }
      }
    },
    "operationKey" : {
      "type" : [ "string", "null" ]
    },
    "rerankerModelPath" : {
      "type" : [ "string", "null" ]
    },
    "restartScheduled" : {
      "type" : [ "boolean", "null" ]
    },
    "settingsMode" : {
      "type" : [ "string", "null" ]
    },
    "state" : {
      "type" : [ "string", "null" ]
    },
    "ui" : {
      "type" : [ "object", "null" ],
      "properties" : {
        "chatEnabled" : {
          "type" : [ "boolean", "null" ]
        },
        "defaultAction" : {
          "type" : [ "string", "null" ]
        },
        "density" : {
          "type" : [ "string", "null" ]
        },
        "excludePatterns" : {
          "type" : [ "array", "null" ],
          "items" : {
            "anyOf" : [ {
              "type" : "string"
            }, {
              "type" : "object",
              "properties" : {
                "literal" : {
                  "type" : "object",
                  "properties" : {
                    "id" : {
                      "type" : "string"
                    },
                    "path" : {
                      "type" : "string"
                    },
                    "scope" : {
                      "type" : "string",
                      "enum" : [ "FILE", "FOLDER" ]
                    },
                    "version" : {
                      "type" : "integer",
                      "const" : 1
                    }
                  },
                  "required" : [ "id", "path", "scope", "version" ]
                }
              },
              "required" : [ "literal" ]
            } ]
          }
        },
        "hasSeenTrustLoopNudge" : {
          "type" : [ "boolean", "null" ]
        },
        "highContrast" : {
          "type" : [ "boolean", "null" ]
        },
        "indexingPause" : {
          "type" : "object",
          "properties" : {
            "pauseOnBattery" : {
              "type" : "boolean"
            },
            "paused" : {
              "type" : "boolean"
            },
            "reason" : {
              "type" : [ "string", "null" ]
            },
            "schedule" : {
              "type" : "object",
              "properties" : {
                "days" : {
                  "type" : [ "array", "null" ],
                  "items" : {
                    "type" : "integer"
                  }
                },
                "enabled" : {
                  "type" : "boolean"
                },
                "endMinute" : {
                  "type" : "integer"
                },
                "startMinute" : {
                  "type" : "integer"
                }
              }
            },
            "untilEpochMs" : {
              "type" : [ "integer", "null" ]
            }
          },
          "readOnly" : true
        },
        "inspectorWidth" : {
          "type" : [ "integer", "null" ]
        },
        "invalidExcludePatterns" : {
          "readOnly" : true,
          "type" : [ "array", "null" ],
          "items" : {
            "type" : "string",
            "readOnly" : true
          }
        },
        "mode" : {
          "type" : [ "string", "null" ]
        },
        "theme" : {
          "type" : [ "string", "null" ]
        },
        "vimMode" : {
          "type" : [ "boolean", "null" ]
        }
      }
    },
    "witness" : {
      "type" : [ "object", "null" ],
      "properties" : {
        "acceptedRevision" : {
          "type" : "integer"
        },
        "lastCommittedOperationKey" : {
          "type" : [ "string", "null" ]
        }
      },
      "required" : [ "acceptedRevision", "lastCommittedOperationKey" ]
    }
  }
}
