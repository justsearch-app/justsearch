<configuration scan="true" scanPeriod="30 seconds">
  <!--
    Tempdoc 374 alpha.26 hotfix: silence Logback's own Joran startup status
    output. Pre-fix every cold boot wrote ~62 lines of `INFO in
    ch.qos.logback.classic.LoggerContext[default] - Found logback-core ...`
    to STDOUT before Logback's appenders were configured — these bypassed the
    JSON encoder entirely and violated the alpha.24 "every entry is JSON with
    service:<name>" invariant (the name was "head" until item A16 made it "engine").
    Round-15 finding #3.
  -->
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

  <!--
    Logback configuration for the Head process (HeadlessApp, module ui).

    Tempdoc 374 alpha.23 follow-up — closes the Jetty DEBUG noise issue caught
    in round-13 evidence (188K+ DEBUG org.eclipse.jetty.* lines per boot).
    Pre-fix the bundled head jar had no logback.xml, so Logback's
    BasicConfigurator kicked in (root=DEBUG, STDOUT) and Jetty's verbose
    internals flooded the head log at <1% signal density.

    Pattern: each entry-point module owns its own logback.xml, mirroring
    app-launcher/src/main/resources/logback.xml (Launcher process). With this
    file on the ui-headless.jar classpath, Logback finds it automatically in
    both dev (`runHeadless`) and prod (Tauri shell spawn) without any
    -Dlogback.configurationFile system property.

    Lane F stage A item A13 deleted the second config
    (indexer-worker/src/main/resources/logback.xml, the Worker process's). Since item A6 the index
    half runs INSIDE this JVM, so both files were on one classpath and only the first found won.
    Three settings that were real there and absent here were re-homed below: the
    ${JUSTSEARCH_LOG_LEVEL:-INFO} parameterisation of io.justsearch, and the org.apache.lucene /
    org.sqlite noise floors. (The Worker's file/JSON appender and OTel MDC bridge already have
    equivalents here; its worker.log appender was already dead — nothing writes
    <dataDir>/logs/worker.log, see DebugStateController.java.)

    Item A16 then renamed the produced file: <dataDir>/logs/headless-backend.log ->
    <dataDir>/logs/engine.log. "headless-backend" named one half of a process that no longer has
    halves. There is exactly ONE JVM log under <dataDir>/logs/ now (llama-server.log is still
    written by the llama-server CHILD process, and is governed by its own retention policy — see
    governance/store-recoverability.v1.json's llama-server-log row). The file name is pinned by
    modules/ui/src/test/.../EngineLogbackConfigurationTest#fileAppenderWritesEngineLog.
  -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${justsearch.data.dir:-build/headless-data}/logs/engine.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${justsearch.data.dir:-build/headless-data}/logs/engine.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>7</maxHistory>
      <totalSizeCap>256MB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <shortenedLoggerNameLength>48</shortenedLoggerNameLength>
      <fieldNames>
        <timestamp>@timestamp</timestamp>
      </fieldNames>
      <!-- Include MDC correlation keys per Observability guidance -->
      <includeMdcKeyName>trace_id</includeMdcKeyName>
      <includeMdcKeyName>span_id</includeMdcKeyName>
      <includeMdcKeyName>pipeline_name</includeMdcKeyName>
      <includeMdcKeyName>request_id</includeMdcKeyName>
      <includeMdcKeyName>stage_id</includeMdcKeyName>
      <!--
        Item A16: was {"service":"head"}. Renamed with the file for the same reason: there is one
        process, so a per-record field naming one half of it is no longer a fact. Checked for
        consumers before changing it — nothing greps this field (the "service" key that IS read,
        e.g. StatusRecordSchemaTest and jseval's workflow fixture, is /api/status's
        service="JustSearch", a different field on a different payload). An operator's saved
        grep for service:head is the one thing this breaks, which is the point: it should stop
        matching rather than keep naming a process that does not exist.
      -->
      <customFields>{"service":"engine"}</customFields>
    </encoder>
  </appender>

  <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>2048</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
    <appender-ref ref="FILE"/>
  </appender>

  <!-- OTel MDC bridge: injects span_id + trace_flags into log events.
       Must wrap ASYNC (outermost) so OTel context is captured on the originating thread.
       traceIdKey is renamed to avoid conflict with manual trace_id from MdcContext.request(). -->
  <appender name="OTEL_MDC" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
    <traceIdKey>otel_trace_id</traceIdKey>
    <appender-ref ref="ASYNC"/>
  </appender>

  <!-- Console appender for automation breadcrumbs (kept lightweight). -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <withJansi>false</withJansi>
    <encoder>
      <pattern>[%d{HH:mm:ss.SSS}] %-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Emit automation sentinel messages to STDOUT so smoke harness can assert listener lifecycle. -->
  <logger name="io.justsearch.ui.automation" level="INFO" additivity="false">
    <appender-ref ref="STDOUT"/>
    <appender-ref ref="ASYNC"/>
  </logger>

  <!--
    Jetty (Javalin's underlying servlet container) is extremely chatty at DEBUG.
    Round-13 evidence: 188,236 DEBUG org.eclipse.jetty.* lines in a single
    install-boot log when no logback config was found and BasicConfigurator
    kicked in at root=DEBUG. Even at INFO Jetty is fairly chatty
    ("Started HTTP/1.1 on …" etc.) — WARN keeps the signal-to-noise high.
    Bump this to INFO temporarily if diagnosing a Jetty-specific issue.
  -->
  <logger name="org.eclipse.jetty" level="WARN"/>
  <!-- Javalin's own internals are quieter at INFO; keep them visible. -->
  <logger name="io.javalin" level="INFO"/>

  <!--
    Re-homed from the Worker's deleted logback.xml (item A13). Lucene and SQLite now run in THIS
    JVM, and both are chatty below WARN.
  -->
  <logger name="org.apache.lucene" level="WARN"/>
  <logger name="org.sqlite" level="WARN"/>

  <!--
    Also re-homed from the Worker's config (tempdoc 734 O-2, commit 9a2a7807).
    io.justsearch defaults to INFO, NOT DEBUG: several call sites intentionally log raw user
    query/chat text at DEBUG/TRACE per the WARN/DEBUG split in
    docs/reference/contributing/logging-conventions.md ("Query Text Redaction"). The diagnostics
    export bundles logs/ (DiagnosticsServiceImpl#addDirectoryRedacted) with path-only redaction —
    no query/content redaction — so query text must not be written at INFO or above.
    JUSTSEARCH_LOG_LEVEL=DEBUG restores verbose local debugging; scripts/dev/dev-runner.cjs sets it
    for the dev stack, which before A13 had no effect on the Engine because only the Worker's
    (unloaded) config read it. Do not lower this default instead.
    Pinned by modules/ui/src/test/.../EngineLogbackConfigurationTest.
  -->
  <logger name="io.justsearch" level="${JUSTSEARCH_LOG_LEVEL:-INFO}"/>

  <root level="INFO">
    <appender-ref ref="OTEL_MDC"/>
  </root>
</configuration>
