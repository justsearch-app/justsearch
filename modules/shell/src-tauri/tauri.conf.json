{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustSearch",
  "mainBinaryName": "JustSearch",
  "version": "0.3.1",
  "identifier": "io.justsearch.shell",
  "build": {
    "beforeDevCommand": "node ../../scripts/lib/tool-invoker.cjs npm --prefix ../ui-web run dev -- --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "node ../../scripts/lib/tool-invoker.cjs npm --prefix ../ui-web run build && node ../../scripts/lib/tool-invoker.cjs gradle --no-daemon -p ../.. -PskipWebBuild=true :modules:ui:bundleSidecar",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../ui-web/dist",
    "removeUnusedCommands": true
  },
  "bundle": {
    "active": true,
    "publisher": "Elias Justus",
    "copyright": "JustSearch 0.3.1 - Copyright (c) JustSearch",
    "resources": [
      "resources/headless/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "justsearch"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "app": {
    "windows": [
      {
        "title": "JustSearch",
        "width": 1024,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "alwaysOnTop": false,
        "shadow": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self'"
    }
  }
}
