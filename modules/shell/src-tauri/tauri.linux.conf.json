{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node ../../scripts/lib/tool-invoker.cjs npm --prefix ../ui-web run build && node ../../scripts/lib/tool-invoker.cjs gradle -p ../.. -PskipWebBuild=true :modules:ui:bundleSidecar"
  },
  "bundle": {
    "category": "Utility",
    "homepage": "https://github.com/justsearch-app/justsearch",
    "targets": [
      "deb"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "linux/JustSearch.desktop.hbs",
        "depends": [
          "libc6 (>= 2.39)",
          "libstdc++6 (>= 14)",
          "tesseract-ocr",
          "tesseract-ocr-eng"
        ]
      }
    }
  }
}
