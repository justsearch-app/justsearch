#!/bin/sh
set -eu
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
[ "$#" -ge 2 ] || { printf >&2 '%s\n' 'pre-push: remote name and URL are required for the commit privacy boundary check.'; exit 1; }

# Preserve Git's complete ref-update protocol while checking every outgoing
# commit. Git LFS must receive the same bytes on stdin after the guard passes.
repo_root="$(git rev-parse --show-toplevel)"
remote_name="$1"
remote_url="$2"
input_file="$(mktemp "${TMPDIR:-/tmp}/justsearch-pre-push.XXXXXX")"
trap 'rm -f "$input_file"' EXIT HUP INT TERM
cat >"$input_file"

# Git supplies the actual old and new object IDs regardless of push flags.
# Check every update before privacy checks, expensive gates, or LFS run.
while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # Deletions stay allowed.
  case "$remote_sha" in *[!0]*) ;; *) continue ;; esac # New refs have no history to replace.
  if ! git cat-file -e "$remote_sha" 2>/dev/null; then
    printf >&2 'pre-push: %s (%s -> %s): remote old object is missing locally; fetch first, then retry.\n' "$remote_ref" "$remote_sha" "$local_sha"
    exit 1
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
      printf >&2 'pre-push: %s (%s -> %s): ancestry unknown in a shallow clone; run git fetch --unshallow (or deepen) and retry.\n' "$remote_ref" "$remote_sha" "$local_sha"
      exit 1
    fi
    printf >&2 'pre-push: %s (%s -> %s): history replacement is not allowed.\n' "$remote_ref" "$remote_sha" "$local_sha"
    exit 1
  fi
done <"$input_file"

node "$repo_root/scripts/ci/check-commit-identity-privacy.mjs" --pre-push-input "$input_file" --remote-name "$remote_name" --remote-url "$remote_url"

run_push_gates=0
while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  case "$remote_ref" in
    refs/heads/main) ;;
    refs/heads/*)
      case "$local_sha" in
        *[!0]*) run_push_gates=1; break ;;
      esac
      ;;
  esac
done <"$input_file"
if [ "$run_push_gates" = 1 ]; then
  if [ "${JUSTSEARCH_SKIP_PUSH_GATES:-}" = 1 ]; then
    printf >&2 '%s\n' 'pre-push: test-intent and store-recoverability checks skipped (JUSTSEARCH_SKIP_PUSH_GATES=1).'
  else
    (
      cd "$repo_root"
      # Use CI's commands; test-intent resolves the local merge-base with origin/main or main.
      if ! node scripts/governance/run.mjs --gate test-intent --mode gate; then
        printf >&2 '%s\n' 'pre-push: test-intent check failed; push refused.'
        exit 1
      fi
      if ! node scripts/ci/check-store-recoverability.mjs; then
        printf >&2 '%s\n' 'pre-push: store-recoverability check failed; push refused.'
        exit 1
      fi
    )
  fi
fi
git-lfs pre-push "$@" <"$input_file"
