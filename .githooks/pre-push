#!/bin/sh
set -eu
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
[ "$#" -ge 2 ] || { printf >&2 '%s\n' 'pre-push: remote name and URL are required for the commit privacy boundary check.'; exit 1; }

# Preserve Git's complete ref-update protocol while checking every outgoing
# commit. Git LFS must receive the same bytes on stdin after the guard passes.
repo_root="$(git rev-parse --show-toplevel)"
remote_name="$1"
remote_url="$2"
input_file="$(mktemp "${TMPDIR:-/tmp}/justsearch-pre-push.XXXXXX")"
trap 'rm -f "$input_file"' EXIT HUP INT TERM
cat >"$input_file"
node "$repo_root/scripts/ci/check-commit-identity-privacy.mjs" --pre-push-input "$input_file" --remote-name "$remote_name" --remote-url "$remote_url"
git-lfs pre-push "$@" <"$input_file"
