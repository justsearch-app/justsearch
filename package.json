{
  "name": "justsearch",
  "version": "1.0.0",
  "description": "Local‑first desktop search with Lucene, optional local LLM assist, and strong offline/security posture.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "bootstrap": "node scripts/setup/bootstrap.mjs",
    "bootstrap:check": "node scripts/setup/bootstrap.mjs --check",
    "test:bootstrap": "node --test scripts/setup/*.test.mjs",
    "doctor": "node scripts/dev/doctor.mjs",
    "analyze:skill-delivery": "node scripts/agent-analytics/skill-delivery.mjs",
    "test:agent-analytics": "node scripts/agent-analytics/run-all-tests.mjs",
    "test:governance": "node scripts/governance/run-all-tests.mjs",
    "test:dev-tool-usage": "node scripts/agent-analytics/dev-tool-usage.test.mjs",
    "test:dev-runner": "node scripts/dev/test-dev-runner-runtime-resolution.mjs && node scripts/dev/test-dev-runner-head-java-opts.mjs",
    "test:resolve-jdk": "node scripts/dev/test-resolve-jdk.mjs",
    "lint:scripts": "eslint scripts packaging --max-warnings=0",
    "lint:ps1": "node scripts/ci/check-ps1-warning-comments.mjs",
    "test:lint-ps1": "node --test scripts/ci/check-ps1-warning-comments.test.mjs",
    "lint:md": "markdownlint docs/explanation/**/*.md docs/reference/**/*.md docs/how-to/**/*.md docs/decisions/**/*.md",
    "lint:docs": "node scripts/docs/docs-validate.mjs",
    "check:llmstxt": "node scripts/docs/llmstxt-generate.mjs --check",
    "docs:anchor-audit": "node scripts/docs/anchor-audit.mjs --root docs",
    "docs:anchor-audit:write": "node scripts/docs/anchor-audit.mjs --root docs --fix-links"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "overrides": {
    "markdownlint-cli": {
      "minimatch": "^10.2.4"
    },
    "hono": "^4.12.25",
    "@hono/node-server": "^1.19.11",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "madge": "^8.0.0",
    "markdown-it": "14.2.0",
    "markdownlint-cli": "^0.49.0",
    "toposort": "^2.0.2",
    "zod": "^4.4.3"
  }
}
