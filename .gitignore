.DS_Store
/out/
**/native-bin/

# Test failure dumps (accidentally created at repo root)
/0/

# Ignore Gradle build outputs in all subprojects
**/build/
**/.gradle/

# Ignore compiled plugin outputs for included build
build-logic/bin/

# Unresolved ${user.home} placeholder directory tree accidentally created under any module
# (unresolved property substitution writes a literal top-level dir named "${user.home")
modules/*/\$\{user.home/**
# Launcher smoke profile output outside the repo root
.justsearch-smoke/

# Node modules
node_modules/

# Web build outputs (ui-web and copied resources)
modules/ui-web/dist/
modules/ui/src/main/resources/web/
modules/ui/build/headless-dist/

# Local tool caches (JDK/Node) — do not commit
/.tools/

# Do not version generated documentation artifacts
docs/_generated/




# Distribution / reports
dist/
# Discipline-gate fixtures need to ship dist/ payloads to exercise the
