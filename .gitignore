hs_err_pid*.log
replay_pid*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Eclipse IDE
.project
.settings/

# Claude Code worktree state (session-specific, not source)
.claude/worktrees/
# Claude Code scratch (session-specific, often full checkouts of other repos)
.claude/scratch/
# `.agents/skills` is the committed Codex projection of `.claude/skills`.
# Regenerate it with `node scripts/docs/skills-sync.mjs`.

# Evaluation datasets (large, fetched on demand).
# The trailing wildcard covers per-member staging dirs (datasets-miracl/, etc.):
# a bare `datasets/` entry left those tracked, and one such dir reached 2.5 GB
# untracked-but-stageable before this was caught (tempdoc 767 §O).
datasets/
datasets-*/

# Eval toolkit scratch (session-specific outputs)
scripts/jseval/tmp/

# Campaign run outputs are never committed (tempdoc 930 chunk C; policy in
# scripts/jseval/README.md "Data policy"). `runs/` is the destination for new
# campaigns; the `*-run-*`/`*-pilot-*` forms cover the historical naming so a
# resurrected campaign dir cannot be staged by accident. Two pre-930 evidence
# sets are deliberately re-admitted below: they back the accepted, sha256-chained
# agent-utility publication and canonical search-quality-register entries, so
# deleting them would falsify a published claim.
scripts/jseval/runs/
scripts/jseval/*-run-*/
scripts/jseval/*-pilot-*/
!scripts/jseval/624-run-2026-07-03/
!scripts/jseval/624-run-2026-07-18-confirmatory/
!scripts/jseval/782-run-2026-07-28-hero/

# stray commit-message temp files
.git-msg.tmp

# jqwik (PBT) persisted failing-sample DB — local, not committed (tempdoc 554)
.jqwik-database

# Per-candidate golden-parity baseline: generated by scripts/sandbox/gen_golden_parity.py
# against a dev stack on the candidate's own build. Regenerate per candidate — a stale
# committed baseline would be silently staged against a different build (tempdoc 734).
scripts/sandbox/golden-parity.json
