*.png

# Shipped identity assets (brand/generate.mjs writes exactly these three PNGs; they are listed in
# tauri.conf.json bundle.icon, so the bundler needs them on disk). Named individually, NOT as a
# directory or glob un-ignore -- a stray screenshot dropped anywhere, including in the icons
# directory, must stay ignored.
!/modules/shell/src-tauri/icons/32x32.png
!/modules/shell/src-tauri/icons/128x128.png
!/modules/shell/src-tauri/icons/128x128@2x.png

# Development session artifacts
*.bak
*.out
*.err
/task.md
**/debug_llama*.txt
/.tmp_*
ui_tree*.json
config_cache_test*.txt
e2e_*.txt
test_output*.txt

# Dev-stack runtime data (databases, logs, locks, port files)
.dev-data/
.dev-data-*/

# Orphaned/temp directories at root
/.tmp-*
/tempdocs/
/JustSearch/
/tmp/

# Module-specific temporary directories (dev artifacts, test screenshots, evidence bundles)
modules/*/tmp/

# Browser automation caches (Puppeteer/Chromium)
scripts/**/.local-chromium/
scripts/**/.cache/
# `chrome/` was historically over-broad (intended for browser
# binaries; ended up excluding source `modules/ui-web/src/shell-v0/chrome/`
# which holds the Lit chrome — Stage/Rail/Shell). 477-execution
# critical-analysis caught this. Allow the source chrome dir
# explicitly.
chrome/
!modules/ui-web/src/shell-v0/chrome/
!modules/ui-web/src/shell-v0/chrome/**
**/chrome-linux*/

# Claude Code temporary directories
tmpclaude-*/
nul

# Cargo local config (machine-specific build flags)
**/.cargo/

# Claude Code local settings (may contain tokens or permissions)
.claude/settings.local.json
# Runtime lock files (e.g. .claude/scheduled_tasks.lock) — session-local state;
# committing causes conflicts between concurrent Claude sessions.
.claude/*.lock
.mcp.json

# Local agent evidence captures
agent-review/

# Inference runtime artifacts (model ID written at runtime). Slice 518's
# inference-transitions NDJSON sidecar + head crash-dump writer can also
# land at the repo root when the head launches from there during dev — OR
# under modules/ui/ when the head launches via `:modules:ui:run` (Gradle
# sets that module's own directory as the working directory), reproduced
# tempdoc 663 (2026-07-01): modules/ui/telemetry/inference-transitions.ndjson.
modules/app-inference/inference-model-id.txt
/inference-model-id.txt
/crashes/
/telemetry/
modules/ui/telemetry/

# Playwright test result caches
modules/ui-web/test-results-codex/

# Extracted/decompiled Gradle plugin sources (appear at repo root)
net/

# Mangled Windows-path temp files (D：code... with Unicode fullwidth colon)
D*codeJustSearch*
modules/ui/inference-model-id.txt

# Stale compiled classes outside build directories
/io/

