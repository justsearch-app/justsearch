            "const" : 2
          },
          "startedAt" : {
            "type" : "string"
          },
          "worker" : {
            "$ref" : "#/components/schemas/runtime-manifest-public/$defs/worker"
          }
        },
        "required" : [ "schemaVersion", "instanceId", "pid", "startedAt", "dataDir", "head" ],
